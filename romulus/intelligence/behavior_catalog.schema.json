{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://romulus.local/schemas/behavior_catalog.schema.json",
  "title": "ROMULUS Behavioral Seed Catalog",
  "type": "object",
  "required": [
    "catalog_version",
    "analytics"
  ],
  "additionalProperties": false,
  "properties": {
    "catalog_version": {
      "type": "string",
      "minLength": 1
    },
    "generated_from": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "analytics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "title",
          "description",
          "enabled",
          "platforms",
          "categories",
          "source",
          "required_roles",
          "optional_roles",
          "match",
          "base_priority",
          "specificity",
          "expected_noise",
          "attack_techniques",
          "benign_explanations",
          "required_corroboration",
          "follow_up",
          "provenance",
          "review_date",
          "classification_policy"
        ],
        "properties": {
          "classification_policy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "default_classification",
              "single_record_reportable",
              "minimum_owned_evidence",
              "required_context_roles",
              "upgrade_rule",
              "downgrade_rule",
              "policy_version",
              "policy_reason"
            ],
            "properties": {
              "default_classification": {
                "enum": ["anomalous", "suspicious"]
              },
              "single_record_reportable": {
                "type": "boolean"
              },
              "minimum_owned_evidence": {
                "type": "integer",
                "minimum": 1
              },
              "required_context_roles": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "upgrade_rule": {
                "enum": ["none", "independent_typed_entity_within_30m"]
              },
              "downgrade_rule": {
                "const": "explicit_benign_evidence_only"
              },
              "policy_version": {
                "type": "integer",
                "minimum": 1
              },
              "policy_reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
