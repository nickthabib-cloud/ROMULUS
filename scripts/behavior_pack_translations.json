      "to_filter": {"field": "event.outcome", "operator": "equals", "values": ["success"]},
      "from_count": 5,
      "window_minutes": 15,
      "sample_min": 6,
      "threshold": {"operator": "gte", "value": 1}
    },
    "service_principal_high_failure_rate": {
