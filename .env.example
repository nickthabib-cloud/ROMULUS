# ROMULUS configuration. Copy to $ROMULUS_HOME/.env and chmod 600. Never commit the real file.
ROMULUS_HOME=/opt/romulus           # data, database, reports and logs live here
# Optional Windows collection attestation is read from $ROMULUS_HOME/site/collection.yaml.
# That file also accepts approved_remote_access: a list of IDs from content/network/services.json.
# An approval adds context to an observed service domain; it never suppresses or lowers the lead.
ROMULUS_WEB_BIND=127.0.0.1:8443
ROMULUS_SECRET_KEY=                 # random 32+ chars; signs web sessions
# Built-in TLS for the web UI: both files, or neither. `romulus web` refuses plain HTTP on any address but
# loopback. A self-signed pair (key readable by the service account only):
#   openssl req -x509 -newkey rsa:3072 -nodes -days 365 -subj "/CN=romulus" -keyout key.pem -out cert.pem && chmod 600 key.pem
ROMULUS_WEB_TLS_CERT=               # path to the PEM certificate (chain)
ROMULUS_WEB_TLS_KEY=                # path to the PEM private key
ROMULUS_WEB_ALLOW_PLAINTEXT=0       # 1 accepts plain HTTP off loopback (isolated lab only; doctor warns)
ROMULUS_WEB_TRUSTED_PROXIES=        # comma-separated reverse proxy IP addresses (single addresses, no networks or *)
                                    # whose X-Forwarded-For/-Proto headers are trusted
ROMULUS_COOKIE_SECURE=0             # 1 marks the session cookie Secure without built-in TLS (TLS proxy in front)
ROMULUS_EVAL_ROOT=                  # optional: evaluation ground truth, kept out of every source path

# Optional model: ROMULUS works fully without one. Leave OLLAMA_URL empty to run model-off.
OLLAMA_URL=                         # e.g. http://<model-host>:11434 on a private network
OLLAMA_MODEL_TRIAGE=                # the model name as your server lists it
OLLAMA_MODEL_SYNTHESIS=
OLLAMA_NUM_CTX=8192                 # always explicit: Ollama truncates prompts silently
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_KEEP_ALIVE=30m
OLLAMA_THINK=false

# Optional AI investigating agent. Leave AGENT_BASE_URL or AGENT_MODEL empty and hunts run without it;
# `romulus doctor` then reports "agent not configured". Deterministic results never depend on the agent.
AGENT_PROVIDER=openai_compatible    # openai_compatible (any server speaking the OpenAI Chat Completions API) | ollama
                                    # | openai_responses (the OpenAI Responses API, for reasoning models with tools)
                                    # | anthropic (the Claude Messages API; needs the optional SDK: see README, Model providers)
AGENT_BASE_URL=                     # API root containing /chat/completions, e.g. http://<model-host>:8000/v1
                                    # (openai_responses: the root containing /responses; empty means
                                    # https://api.openai.com/v1. anthropic: empty means https://api.anthropic.com)
AGENT_API_KEY=                      # required for a remote endpoint and for anthropic; optional for your own server
AGENT_MODEL=                        # the model id as the provider lists it: pin an exact id, not a moving "latest" alias
                                    # (CLI: hunt start/resume and doctor --agent-model <id> replace it for that run only;
                                    # the hunt records the model it used, and resume keeps that model unless --force-model)
AGENT_DEFAULT=on                    # run the agent on new hunts when it is configured (CLI: --no-agent)
AGENT_CONTEXT_TOKENS=0              # the model's context window, to detect a cut-off prompt; 0 = let the server enforce it
                                    # (anthropic: 0 = the window the models endpoint reports)
AGENT_MAX_OUTPUT_TOKENS=4096        # per call. The final assessment, with its narrative, is typically 3000-5000 tokens:
                                    # on a provider that adds no AGENT_THINKING_TOKENS room (openai_compatible, ollama)
                                    # its call automatically gets at least 8192, never past the model's reported limit
                                    # nor past a third of a known context window (OLLAMA_NUM_CTX, AGENT_CONTEXT_TOKENS)
AGENT_TIMEOUT_SECONDS=180           # per call (per read while a reply streams; 600 or more for openai_responses at
                                    # effort high and above, whose models can reason silently for minutes, and a
                                    # read that times out after the reply began is billed); transport errors and 429/5xx are
                                    # retried up to 3 times
# anthropic and openai_responses. Reasoning is always on: effort sets how much the model thinks, and each call's
# output limit is AGENT_MAX_OUTPUT_TOKENS plus AGENT_THINKING_TOKENS so thinking cannot crowd out the answer.
# Conversations must be append-only: the adapter rejects an edited history. openai_responses sends store=false, so
# responses are not saved for later retrieval (OpenAI's data retention policy still applies), and asks for reasoning
# summaries; a model that does not accept an effort value says so in `romulus doctor`.
AGENT_EFFORT=high                   # low | medium | high | xhigh | max
AGENT_THINKING_TOKENS=60000
# anthropic only: a refusal by the API's safety classifier is answered by the fallback model it recommends unless
# AGENT_REFUSAL_FALLBACK=off; every call records the model that answered.
AGENT_REFUSAL_FALLBACK=default      # default | off
# Per-hunt budgets, checked before every call. Reaching one stops agent work; it never hides a finding.
# These are the "standard" budget profile. Each hunt pins its own budget when it is created (a profile: quick, standard
# or deep, plus optional per-limit values), and its agent, its triage pass and every resume read that pinned budget,
# never these live values: a change here applies to new hunts only. More budget can be added to a hunt later
# (`romulus hunt extend`, or the hunt's Run tab); spending persists, so the new limit is the pinned one plus the added.
AGENT_MAX_CALLS=200
AGENT_MAX_TOKENS=2000000            # budget tokens, weighted by price (see the cache token weights below)
AGENT_MAX_WALL_SECONDS=3600
AGENT_MAX_COST_USD=0                # 0 = no cost budget; otherwise set every price below that a call can be charged
AGENT_PRICE_INPUT_PER_MTOK=0        # USD per million prompt tokens, for the cost estimate
AGENT_PRICE_OUTPUT_PER_MTOK=0       # USD per million completion tokens
AGENT_ASSESS_RESERVE_FRACTION=0.15  # preserve this fraction of each hunt budget for its assessment call
# Output caps bound model-created records per hunt; reaching a cap is reported and never affects detection.
AGENT_MAX_INITIAL_HYPOTHESES=8      # at most this many hypotheses may be opened during orient
AGENT_MAX_HYPOTHESES=40             # total hypotheses; at the cap the model must update an existing one
AGENT_MAX_SESSIONS_PER_HYPOTHESIS=4 # maximum fresh investigation sessions for one hypothesis
AGENT_MAX_FINDINGS=200              # maximum separately labelled AI findings
AGENT_MAX_LINKS=300                 # maximum non-joining agent hypothesis links
AGENT_MAX_NOTES=500                 # maximum notes attached to hunt objects
AGENT_MAX_RAW_RECORDS=1000          # maximum unnormalized rows kept as citable raw records (16 KB each)
# Prompt tokens read from and written to the provider's prompt cache (the anthropic adapter caches the tools,
# system prompt and conversation). A priced anthropic agent needs the model's cache-read price; the write price
# defaults to 1.25 x the input price. For other providers an unset cache price is the input price.
AGENT_PRICE_CACHE_READ_PER_MTOK=0
AGENT_PRICE_CACHE_WRITE_PER_MTOK=0
# anthropic only: the token budgets (AGENT_MAX_TOKENS, AGENT_TRIAGE_MAX_INPUT_TOKENS) count each prompt token at its
# price relative to an uncached one: a cache read at about a tenth of it, a five-minute cache write at 1.25 times it.
# Output tokens count once, and every other provider counts each token once. The raw counts are recorded as well,
# and AGENT_MAX_COST_USD, when set, stays a separate cap.
AGENT_CACHE_READ_TOKEN_WEIGHT=0.1
AGENT_CACHE_WRITE_TOKEN_WEIGHT=1.25
# anthropic with AGENT_REFUSAL_FALLBACK=default: a declined call is billed, then answered and billed again by the
# fallback model at its own prices, so a priced agent needs those prices too (its cache writes cost 1.25 x its
# input price). Each attempt is charged at the prices of the model that served it.
AGENT_PRICE_FALLBACK_INPUT_PER_MTOK=0
AGENT_PRICE_FALLBACK_OUTPUT_PER_MTOK=0
AGENT_PRICE_FALLBACK_CACHE_READ_PER_MTOK=0
# a session's reads (findings, evidence, incidents, pivots, links), plus one per dossier page or cited finding it is
# handed (at most 3 x this more); the tools that record its work get 4 x this, and finishing is always allowed
AGENT_MAX_TOOL_CALLS_PER_SESSION=25
# read-only source queries the agent's pivots may make in one hunt (each is bounded; the agent is also bounded by its
# calls, tokens and wall clock); orient takes at most 20% of them, each investigate session the rest divided by the
# open hypotheses still to work, and one tool call at most 10% of its session's share (never less than 32)
AGENT_MAX_SOURCE_QUERIES=2000
AGENT_CONCURRENCY=2
# Arkime sessions the agent may read the packets of (read_session) per hunt, and the packet bytes those reads may
# fetch together (each fetch is capped as the packet stage caps its own); a refused read is reported, never a negative
AGENT_MAX_SESSION_READS=50
AGENT_MAX_SESSION_READ_BYTES=268435456
# The most an analyst may give one hunt's agent, as a multiple of the standard limits above (each limit of a hunt's
# pinned budget plus its extensions stays within it, and within the limit's own maximum). Only a lead account may go
# above it, up to each limit's maximum. The deep profile (4x calls, tokens, source queries and cost, 6x wall clock)
# fits under the default.
AGENT_BUDGET_CEILING_MULTIPLIER=8
# AI triage order: a labelled, promote-only view over the surfaced findings, run inside the agent phase after the
# investigation and before the assessment (whose input carries its verdicts), or with `romulus triage <hunt>`. It
# never changes lanes, ranks, the Reported set or the deterministic report order. Its time is not charged to
# AGENT_MAX_WALL_SECONDS, so an agent phase can run up to AGENT_TRIAGE_MAX_WALL_SECONDS longer than that.
AGENT_TRIAGE=on                      # on | off: run it automatically when the agent is enabled
AGENT_TRIAGE_MODEL=                  # the triage pass's model on the same provider; empty = AGENT_MODEL
                                     # (`romulus triage --agent-model <id>` replaces it for that run only; the
                                     # triage summary records the model it used, apart from the agent's;
                                     # its cost is estimated at the AGENT_PRICE_* prices and token weights above)
AGENT_TRIAGE_PROMOTE_PER_LANE=10     # groups that may move ahead within one report section
AGENT_TRIAGE_MAX_CALLS=100           # model calls per triage pass
AGENT_TRIAGE_MAX_INPUT_TOKENS=4000000    # prompt budget tokens per pass (weighted by price; worst case checked first)
AGENT_TRIAGE_MAX_OUTPUT_TOKENS=2000000   # output tokens per pass, thinking room included in the worst case
AGENT_TRIAGE_MAX_WALL_SECONDS=1800      # includes staging and cards, linear in the hunt's findings and groups
# AGENT_MAX_COST_USD and the AGENT_PRICE_* settings also cap each triage pass, separately: the agent and each triage
# pass can each spend up to AGENT_MAX_COST_USD.
AGENT_TRIAGE_CALL_INPUT_TOKENS=30000     # group cards carried by one call
AGENT_TRIAGE_CALL_OUTPUT_TOKENS=8192     # answer room of one call
AGENT_TRIAGE_CITED_MAX_GROUPS=20         # after the assessment: groups of Reported findings the AI narrative cites
                                         # that the pass left without a verdict, triaged on the same model and budget
                                         # (those cited by the most paragraphs first; the rest are counted); 0 = none
# Model egress. An endpoint is local when it is loopback, RFC 1918, IPv6 unique-local, or listed below.
# Any other endpoint is refused unless ROMULUS_MODEL_EGRESS=lab-public-data: the explicit opt-in for a remote model
# endpoint the operator has approved for the hunt's data (the value keeps its name for existing installs). A remote
# endpoint must use https, `romulus doctor` names it, and reports carry a banner naming the host and model.
ROMULUS_MODEL_EGRESS=
MODEL_LOCAL_HOSTS=                  # comma-separated hostnames, addresses or CIDRs of your own model servers

ES_URL=http://127.0.0.1:9200
ES_FLAVOR=elasticsearch             # elasticsearch (8 or later) | opensearch (2.4 or later); must match the cluster
ES_USERNAME=                        # a read-only account; never the elastic superuser
ES_PASSWORD=
ES_API_KEY=
ES_CA_CERT=
ES_VERIFY_TLS=true
ES_INDEX_PATTERNS=                  # comma-separated index or data-stream patterns, e.g. logs-host-*,logs-net-*
ES_READ_ONLY_ROLES=                 # OpenSearch with its security plugin: comma-separated names of your read-only
                                    # roles, e.g. <read-only-role>. `romulus doctor` reports the account read-only
                                    # only when every role it holds is listed; otherwise it warns
ES_COMPRESSION=true                 # false asks for uncompressed responses: less CPU here, more bytes on the network
ROMULUS_SWEEP_PREFETCH=false        # fetch the next sweep partition while the current one is evaluated (holds one
                                    # more partition's records in memory); false fetches strictly one at a time
ROMULUS_MENTION_RESIDUE_RECORDS=1000000  # records outside the sweep's selection the mention scan reads per source;
                                    # past it the smallest datasets are read whole first and every record not read is
                                    # counted as not scanned; 0 reads none (they are named as not offered)
ROMULUS_STAGE_DIR=                  # where hunts stage events and detector state (default ROMULUS_HOME/stage). Use a
                                    # volume no other service writes to: never the one holding Elasticsearch, Arkime
                                    # or docker data (a full volume can block their indices); `romulus doctor` checks
ROMULUS_STATE_DISK_GB=0             # disk a hunt's detector state may use; 0: the smaller of half the stage volume's
                                    # free space and 10% of its size
ROMULUS_STATE_DISK_RESERVE_GB=2     # least free space always left on the stage volume (at least 15% of its size is
                                    # kept free in any case); reaching it makes coverage partial, never a crash
ROMULUS_STATE_MEMORY_MB=1536        # memory every rule's in-memory state shares; the rest waits on disk
ROMULUS_BASELINE_RETAIN_DISK_GB=2   # database space for the counts partial hunts keep so a resumed run can still write
                                    # baseline history; over it, the oldest are released (findings are unaffected)
ROMULUS_BASELINE_CARRY_DISK_GB=4    # database space for kept per-hour parent carry input; over it, the oldest hours
                                    # are dropped and read again when a hunt needs them
ROMULUS_EXPANSION_MAX_SOURCE_QUERIES=20000  # most source queries post-sweep expansion may make in one hunt; each
                                    # anchor brings its own share up to this total, and links cut by it are stated
ROMULUS_EXPANSION_WALL_CLOCK_MINUTES=120    # expansion's own time limit, counted from when expansion starts
ROMULUS_HUNT_STOP_GRACE_SECONDS=60  # how long a hunt or its agent has to honour a stop request (at its next source
                                    # partition, expansion link, model call or tool call) before a lead may force-stop
                                    # its worker process

ARKIME_URL=http://127.0.0.1:8005
ARKIME_USERNAME=
ARKIME_PASSWORD=
ARKIME_VERIFY_TLS=true
ARKIME_BASE_PATH=                   # the viewer's path prefix behind a proxy, e.g. /arkime; empty: served at the root
ARKIME_AUTH=digest                  # digest (the viewer's own login) | basic (an authenticating proxy in front of it;
                                    # use an https ARKIME_URL)

# The site's own address space. Many mission networks use public addresses internally, and partner or VPN
# networks may use RFC 1918 space, so set both for every site. Comma-separated CIDRs; a malformed value stops
# startup. Unset, the RFC 1918 and reserved ranges are assumed and labelled "default": rules whose negative depends
# on traffic direction then report partial coverage, and `romulus doctor` warns. Loopback and link-local ranges
# are always internal.
ROMULUS_INTERNAL_NETWORKS=          # e.g. <site-range-1>/<prefix>,<site-range-2>/<prefix>
ROMULUS_EXTERNAL_NETWORKS=          # carve-outs inside the ranges above that are outside the site (partner, VPN)
                                    # the most specific range wins: a carve-out beats the internal range around it

PCAP_ALLOWED_DIRS=                  # optional, comma-separated: `romulus doctor` checks that each exists; hunts
                                    # fetch packets from Arkime, not from these directories
TSHARK_BIN=tshark
MISSION_TIMEZONE=UTC
