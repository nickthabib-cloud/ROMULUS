# ROMULUS deployment configuration. Copy to .env and protect it (chmod 600).
ROMULUS_HOME=/home/user/ROMULUS
ROMULUS_MODE=live

# Local inference endpoint on the Windows host-only interface
OLLAMA_URL=http://192.168.36.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=180

# Elasticsearch: read-only account only. Supply password in .env locally.
ES_URL=http://127.0.0.1:9200
ES_USERNAME=romulus_agent
ES_PASSWORD=
ES_INDEX_PATTERNS=ainception-hostlogs-a-b,ainception-network-a-b
ES_VERIFY_TLS=true
ES_LOOKBACK_HOURS=24
HISTORICAL_SEARCH=true

# Arkime deployment details. A supported authenticated API requires configuration.
ARKIME_URL=http://127.0.0.1:8005
ARKIME_USERNAME=
ARKIME_PASSWORD=
ARKIME_API_PATH=/api/sessions
ARKIME_DATE_HOURS=24

# ISO timestamps without an explicit Z/offset are interpreted in this zone.
# Use the timezone in which analysts read Kibana/Arkime timestamps.
MISSION_TIMEZONE=UTC

# Only paths under these directories can be opened as PCAPs.
PCAP_ALLOWED_DIRS=/opt/arkime/ainception-input
PCAP_FILES=/opt/arkime/ainception-input/inetfw-first.pcap,/opt/arkime/ainception-input/inetfw-second.pcap,/opt/arkime/ainception-input/corpdns.pcap
TSHARK_BIN=tshark

# Investigation limits
MAX_TOOL_CALLS=160
MAX_DEPTH=10
MIN_REASONING_ROUNDS=3
MAX_RUNTIME_SECONDS=600
MAX_RESULTS=10000
ARKIME_MAX_RESULTS=20000
# Code-controlled representative windows/reservoirs per capped search (2-24).
TIME_SAMPLING_STRATA=8
# Unique evidence remains in SQLite while a hunt is active or resumable. This
# bounds each source/phase bucket retained in graph state during investigation.
CONTEXT_EVIDENCE_PER_SOURCE=1000
TOOL_TIMEOUT_SECONDS=60
MAX_RETRIES=2
# compact (default) keeps reports, findings, cited evidence, and the supported
# attack-path graph after finalization; full keeps all hunt working data.
RETENTION_POLICY=compact
REPORTS_DIR=/home/user/ROMULUS/reports
DATA_DIR=/home/user/ROMULUS/data
LOGS_DIR=/home/user/ROMULUS/logs
