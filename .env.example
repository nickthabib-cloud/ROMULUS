# ROMULUS configuration. Copy to $ROMULUS_HOME/.env and chmod 600. Never commit the real file.
ROMULUS_HOME=/opt/romulus           # data, database, reports and logs live here
ROMULUS_WEB_BIND=127.0.0.1:8443
ROMULUS_SECRET_KEY=                 # random 32+ chars; signs web sessions
ROMULUS_EVAL_ROOT=                  # optional: evaluation ground truth, kept out of every source path

# Optional model: ROMULUS works fully without one. Leave OLLAMA_URL empty to run model-off.
OLLAMA_URL=                         # e.g. http://<model-host>:11434 on a private network
OLLAMA_MODEL_TRIAGE=                # the model name as your server lists it
OLLAMA_MODEL_SYNTHESIS=
OLLAMA_NUM_CTX=8192                 # always explicit: Ollama truncates prompts silently
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_KEEP_ALIVE=30m
OLLAMA_THINK=false

# Optional AI investigating agent. Leave AGENT_BASE_URL or AGENT_MODEL empty and hunts run without it;
# `romulus doctor` then reports "agent not configured". Deterministic results never depend on the agent.
AGENT_PROVIDER=openai_compatible    # openai_compatible (any server speaking the OpenAI Chat Completions API) | ollama
AGENT_BASE_URL=                     # API root containing /chat/completions, e.g. http://<model-host>:8000/v1
AGENT_API_KEY=                      # required for a remote endpoint; optional for your own local server
AGENT_MODEL=                        # pin a dated snapshot, not a moving "latest" alias
AGENT_DEFAULT=on                    # run the agent on new hunts when it is configured (CLI: --no-agent)
AGENT_CONTEXT_TOKENS=0              # the model's context window, to detect a cut-off prompt; 0 = let the server enforce it
AGENT_MAX_OUTPUT_TOKENS=4096        # per call
AGENT_TIMEOUT_SECONDS=180           # per call; transport errors and 429/5xx are retried up to 3 times
# Per-hunt budgets, checked before every call. Reaching one stops agent work; it never hides a finding.
AGENT_MAX_CALLS=200
AGENT_MAX_TOKENS=2000000
AGENT_MAX_WALL_SECONDS=3600
AGENT_MAX_COST_USD=0                # 0 = no cost budget; otherwise set both prices below
AGENT_PRICE_INPUT_PER_MTOK=0        # USD per million prompt tokens, for the cost estimate
AGENT_PRICE_OUTPUT_PER_MTOK=0       # USD per million completion tokens
AGENT_MAX_TOOL_CALLS_PER_SESSION=25
AGENT_MAX_SOURCE_QUERIES=200
AGENT_CONCURRENCY=2
# Model egress. An endpoint is local when it is loopback, RFC 1918, IPv6 unique-local, or listed below.
# Any other endpoint is refused unless ROMULUS_MODEL_EGRESS=lab-public-data: set it ONLY when hunting public
# datasets, never on mission data. Reports then carry a banner naming the host and model.
ROMULUS_MODEL_EGRESS=
MODEL_LOCAL_HOSTS=                  # comma-separated hostnames, addresses or CIDRs of your own model servers

ES_URL=http://127.0.0.1:9200
ES_FLAVOR=elasticsearch             # elasticsearch | opensearch
ES_USERNAME=                        # a read-only account; never the elastic superuser
ES_PASSWORD=
ES_API_KEY=
ES_CA_CERT=
ES_VERIFY_TLS=true
ES_INDEX_PATTERNS=                  # comma-separated index or data-stream patterns, e.g. logs-host-*,logs-net-*
ES_COMPRESSION=true                 # false asks for uncompressed responses: less CPU here, more bytes on the network
ROMULUS_SWEEP_PREFETCH=false        # fetch the next sweep partition while the current one is evaluated (holds one
                                    # more partition's records in memory); false fetches strictly one at a time
ROMULUS_STAGE_DIR=                  # where hunts stage events and detector state (default ROMULUS_HOME/stage). Use a
                                    # volume no other service writes to: never the one holding Elasticsearch, Arkime
                                    # or docker data (a full volume can block their indices); `romulus doctor` checks
ROMULUS_STATE_DISK_GB=0             # disk a hunt's detector state may use; 0: the smaller of half the stage volume's
                                    # free space and 10% of its size
ROMULUS_STATE_DISK_RESERVE_GB=2     # least free space always left on the stage volume (at least 15% of its size is
                                    # kept free in any case); reaching it makes coverage partial, never a crash
ROMULUS_STATE_MEMORY_MB=1536        # memory every rule's in-memory state shares; the rest waits on disk
ROMULUS_EXPANSION_MAX_SOURCE_QUERIES=20000  # most source queries post-sweep expansion may make in one hunt; each
                                    # anchor brings its own share up to this total, and links cut by it are stated
ROMULUS_EXPANSION_WALL_CLOCK_MINUTES=120    # expansion's own time limit, counted from when expansion starts

ARKIME_URL=http://127.0.0.1:8005
ARKIME_USERNAME=
ARKIME_PASSWORD=
ARKIME_VERIFY_TLS=true

# The site's own address space. Many mission networks use public addresses internally, and partner or VPN
# networks may use RFC 1918 space, so set both for every site. Comma-separated CIDRs; a malformed value stops
# startup. Unset, the RFC 1918 and reserved ranges are assumed and labelled "default": rules whose negative depends
# on traffic direction then report partial coverage, and `romulus doctor` warns. Loopback and link-local ranges
# are always internal.
ROMULUS_INTERNAL_NETWORKS=          # e.g. <site-range-1>/<prefix>,<site-range-2>/<prefix>
ROMULUS_EXTERNAL_NETWORKS=          # carve-outs inside the ranges above that are outside the site (partner, VPN)
                                    # the most specific range wins: a carve-out beats the internal range around it

PCAP_ALLOWED_DIRS=                  # directories TShark may read, comma-separated
TSHARK_BIN=tshark
MISSION_TIMEZONE=UTC
