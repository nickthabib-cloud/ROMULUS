# ROMULUS v2 configuration. Copy to $ROMULUS_HOME/.env and chmod 600. Never commit the real file.
ROMULUS_HOME=/home/user/romulus-v2
ROMULUS_WEB_BIND=127.0.0.1:8443
ROMULUS_SECRET_KEY=            # random 32+ chars; signs web sessions

OLLAMA_URL=http://192.168.36.1:11434
OLLAMA_MODEL_TRIAGE=qwen3:8b   # replaced by the M2 bakeoff winner
OLLAMA_MODEL_SYNTHESIS=
OLLAMA_NUM_CTX=8192            # always explicit: Ollama truncates prompts silently
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_KEEP_ALIVE=30m
OLLAMA_THINK=false

ES_URL=http://127.0.0.1:9200
ES_FLAVOR=elasticsearch        # elasticsearch | opensearch
ES_USERNAME=romulus_agent      # read-only account; never the elastic superuser
ES_PASSWORD=
ES_API_KEY=
ES_CA_CERT=
ES_VERIFY_TLS=true
ES_INDEX_PATTERNS=romulus-host-logs-sl700-e-a,romulus-network-logs-sl700-e-a

ARKIME_URL=http://127.0.0.1:8005
ARKIME_USERNAME=
ARKIME_PASSWORD=
ARKIME_VERIFY_TLS=true

PCAP_ALLOWED_DIRS=/opt/arkime/ainception-input
TSHARK_BIN=tshark
MISSION_TIMEZONE=UTC
